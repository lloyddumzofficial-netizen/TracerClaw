NEXT_PUBLIC_SITE_URL=https://desaynclaw.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_BUCKET_NAME=your-r2-bucket-name
CLOUDFLARE_PUBLIC_URL=https://your-public-r2-domain.example.com

# AI providers
FAL_KEY=your-fal-api-key
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
RECRAFT_API_KEY=

# Payments and admin
ADMIN_EMAIL=admin@example.com
CRON_SECRET=replace-with-long-random-secret
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
DODO_PRODUCT_TINGI=
DODO_PRODUCT_BASIC=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
RESEND_API_KEY=

# Distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Runtime controls
NEXT_PUBLIC_MAINTENANCE_MODE=false
LOG_LEVEL=info

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# PostHog Free Cloud
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Free
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/000000
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=desaynclaw@1.0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1

# Optional: enables production source map upload when Sentry org/project are also configured.
SENTRY_AUTH_TOKEN=
